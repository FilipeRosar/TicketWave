# API e serviços locais
APP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=ticketwave
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
REDIS_PORT=6379

# Chave de assinatura JWT em Base64 (gere com: openssl rand -base64 64 | tr -d '\n')
JWT_SECRET=

# S3 emulado pelo LocalStack
LOCALSTACK_PORT=4566
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ticketwave-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Recuperação de senha. O Compose usa o Mailpit por padrão.
FRONTEND_URL=http://localhost:4200
# SMTP_HOST=smtp.example.test
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@ticketwave.test
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# ID do cliente OAuth do tipo aplicativo da Web.
GOOGLE_CLIENT_ID=
